# Keystatic GitHub-mode configuration (Phase 2).
# Copy to .env.local for local setup, and set the same values in Vercel.

# Flip storage from local (disk) to github (git sync). Must be NEXT_PUBLIC_* so the
# Keystatic admin (client bundle) resolves the same storage as the server. Leave
# unset for local disk dev; on Vercel (production) github is the default anyway.
NEXT_PUBLIC_KEYSTATIC_STORAGE=github

# Random secret used to sign the Keystatic session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=

# These three are produced by Keystatic's "Set up GitHub" flow (see PHASE2-DEPLOY.md).
# Do NOT commit real values — .env.local is gitignored.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
