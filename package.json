{
  "name": "simpaisa-docs-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Keystatic editor for the Simpaisa API docs. Edits the markdown in website/docs that Docusaurus renders, on draft branches with a pull request before anything publishes.",
  "scripts": {
    "gen-tree": "node scripts/gen-docs-tree.mjs",
    "predev": "node scripts/gen-docs-tree.mjs",
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/gen-docs-tree.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "prepare-corpus": "node scripts/prepare-corpus-for-editor.mjs",
    "check-corpus": "node scripts/prepare-corpus-for-editor.mjs --check",
    "check-categories": "node scripts/normalize-categories.mjs --check",
    "normalize-categories": "node scripts/normalize-categories.mjs",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@keystatic/core": "^0.5.47",
    "@keystatic/next": "^5.0.5",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.3",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=20.0"
  }
}
