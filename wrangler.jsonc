/**
 * Cloudflare Workers config for the Keystatic editor.
 *
 * WHY CLOUDFLARE
 * Vercel's Hobby plan forbids commercial use, so hosting the editor there means
 * $20/seat/month against a hard $0 budget. Workers' free tier permits commercial
 * use, the account already runs the docs OAuth Worker, and Workers start from a
 * V8 isolate rather than a container — which removes the ~8s cold start an editor
 * hits when opening the admin after an idle period.
 *
 * The Next.js app is adapted by @opennextjs/cloudflare; `npm run deploy` builds
 * through it. See CLOUDFLARE-DEPLOY.md for the one-time setup and secrets.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simpaisa-docs-editor",
  "main": ".open-next/worker.js",

  // Required by the adapter; must be 2024-09-23 or later.
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    // Keystatic's API routes use Node built-ins.
    "nodejs_compat",
    // Keeps fetch() to public origins from looping back into this Worker.
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "simpaisa-docs-editor"
    }
  ],

  "observability": {
    "enabled": true
  }

  // Secrets are NOT set here — they would be committed. Set them with
  //   wrangler secret put KEYSTATIC_SECRET
  //   wrangler secret put KEYSTATIC_GITHUB_CLIENT_ID
  //   wrangler secret put KEYSTATIC_GITHUB_CLIENT_SECRET
  // Public (non-secret) values go in "vars" or the build environment; see
  // CLOUDFLARE-DEPLOY.md.
}
